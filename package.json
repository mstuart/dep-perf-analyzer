{
  "name": "dep-perf-analyzer",
  "version": "1.0.0",
  "description": "Measure the runtime performance impact of npm dependencies — startup time, memory, and event loop blocking",
  "keywords": [
    "dependency",
    "performance",
    "analyze",
    "startup",
    "memory",
    "impact",
    "require",
    "import",
    "cold",
    "start"
  ],
  "repository": "mstuart/dep-perf-analyzer",
  "license": "MIT",
  "author": {
    "name": "Mark Stuart",
    "email": "mstuart@users.noreply.github.com",
    "url": "https://github.com/mstuart"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "ava && tsd"
  },
  "dependencies": {
    "mem-pressure": "^1.0.0",
    "perf-fn": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "ava": "^8",
    "tsd": "^0.33",
    "ultracite": "7.10.2"
  },
  "engines": {
    "node": ">=22"
  }
}
